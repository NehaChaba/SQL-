use world;
select * from city;
select name, district,concat('location',' ',name,' ',district) from city;
select name,district,concat_ws(' ','location',name,district) from city;
select name, substr(name,1) from city;
select name, substr(name,2) from city;
select name, substr(name,3) ,substr(name,1,3) from city;
select name,substr(name,-3) from city;
select name,substr(name,-3,2) from city;
select length('hello    ');  -- 9 length
select length(trim('hello    '));  -- 5 length
select length('    hello');  -- 9 length
select length(trim('    hello'));   -- 5 length
select length('hel    lo');  -- 9 length
select length(trim('hel    lo'));  -- 9 length
select length('ㄴ'), char_length('ㄴ');
select name, lpad(name,7,'#') from city;
select name, rpad(name,7,'#') from city;
select 6.98 , round(6.98); -- 7
select 6.48 , round(6.48); -- 6 
select 6.48 , round(6.48,1);  -- 6.5
select 6.74 , round(6.74,1); -- 6.7
select 6.48 , round(6.48,2); -- nhi hoga round off
select 6.48 , round(6.48,-1);  -- 10
select 4.48 , round(4.48,-1);  -- 0
select 16.48 , round(16.48,-1); -- 20 
select 14.48 , round(14.48,-1);  -- 10
select 56.48 , round(56.48,-1);  -- 60
select 166.48 , round(166.48,-2);  -- 200
select 116.48 , round(116.48,-2);   -- 100 
select 116.48 , round(116.48,-3);   -- 0
select 166.48 , round(166.48,-3);    -- 0
select 116.48 , round(116.48,-1);    -- 120
select 116.48 , round(876.48,-3);    -- 1000
select 116.48 , round(432.48,-3);     -- 0
select truncate(123.56,1);
select truncate(123.56,2);
select pow(2,4);
select ceil(234.89);  -- 235
select floor(234.67);  -- 234
select mod(10,3);    -- remainder 1 output

 
