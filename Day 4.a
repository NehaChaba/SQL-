use world;
show tables;
select * from city;
select now();
select current_time();
select current_date();
select current_timestamp();
select now(), adddate(now(),2);
select now(), adddate(now(),-2);
select now(), adddate(now(),interval 1 year);
select now(), adddate(now(), interval 1 quarter);
select extract(year from now());
select datediff(current_date(),'2026-10-09');
select datediff(current_date(),'2026-10-05');
select now(),date_format(now(),'%Y %m');
select now(),date_format(now(),'%Y %M');
select now(),date_format(now(),'%y %m');